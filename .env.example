# === Påkrævet for at booking og kontakt virker ===
# Opret gratis på https://resend.com/api-keys (Free: 100 e-mails/dag, 3.000/md.)
# Uden denne nøgle returnerer formularerne 503 — der vises aldrig falsk success.
# Vercel → Project → Settings → Environment Variables → Production (+ Preview)
RESEND_API_KEY=

# === Påkrævet for sitemap, robots og Open Graph i produktion ===
# Canonical offentlig URL. getSiteUrl() læser APP_URL først, derefter denne.
# Local:  lad den være tom og sæt APP_URL (fx http://localhost:3001)
# Live:   https://lukasmoller.dk   (uden trailing slash)
# Vercel → samme sted som ovenfor. Sæt den til det rigtige .dk-domæne, ikke localhost.
NEXT_PUBLIC_SITE_URL=

# Faktisk app-URL til redirects (Stripe success/cancel). Én kilde sammen med
# NEXT_PUBLIC_SITE_URL via getSiteUrl(). Tom i produktion — så bruges
# NEXT_PUBLIC_SITE_URL eller https://lukasmoller.dk. Aldrig localhost som prod-default.
# Local (next på 3001): APP_URL=http://localhost:3001
APP_URL=

# === Valgfri. PostgreSQL (Neon eller Vercel Postgres, free tier) ===
# Uden DATABASE_URL virker siden stadig: booking/kontakt sender kun e-mail.
# Med DATABASE_URL gemmes bookinger, ordrer og klippekort.
# Neon: https://console.neon.tech (gratis) — brug den UPOOLEDE / direct connection string
# med sslmode=require. Vercel kører `prisma migrate deploy` i build, når variablen er sat.
DATABASE_URL=

# === Valgfri Resend-afsender/modtager ===
# TO: defaults til lukasmoller2000@gmail.com (samme som på siden)
BOOKINGS_NOTIFY_EMAIL=

# FROM: indtil et domæne er verificeret på https://resend.com/domains, behold Resends test-afsender.
# Med beth.t@example.com kan du KUN sende TIL den e-mail, du oprettede Resend-kontoen med.
# Efter verificering af dit .dk-domæne: Lukas Møller <booking@dit-domæne.dk>
RESEND_FROM_EMAIL=

# === Stripe TEST-mode. Live nøgler (sk_live_ / pk_live_) afvises. ===
# Booking kører som e-mail-forespørgsel, indtil PAYMENTS_ENABLED=true OG gyldige
# sk_test_ / pk_test_ nøgler + Price IDs er sat. STRIPE_ENABLED er IKKE et flag.
# Kun PAYMENTS_ENABLED styrer om checkout kan bruges (default false).
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs fra Stripe Dashboard (test-mode Products). Ingen hardcodede IDs.
STRIPE_PRICE_PT_SINGLE=
STRIPE_PRICE_PT_5_CLIP=
STRIPE_PRICE_ONLINE_COACHING=

# === Admin (/admin). Uden adgangskode (min. 8 tegn) er siden 404. ===
ADMIN_PASSWORD=

# === Virksomhed. Tomme felter vises IKKE på siden. Opfind ikke CVR/adresse. ===
COMPANY_NAME=Lukas Møller
COMPANY_CVR=
COMPANY_ADDRESS=
CONTACT_EMAIL=

# === Handel ===
CANCELLATION_HOURS=24
CLIP_EXPIRY_MONTHS=12
# REFUND_POLICY — tom = default i koden (lovbestemte rettigheder + afbuds-/klipvilkår).
# Sæt ikke en generel "ingen refundering"-regel.
REFUND_POLICY=

# === Moms. Default: ingen moms, indtil det bekræftes. Priserne på siden ER kundens pris. ===
VAT_REGISTERED=false
VAT_RATE=25
VAT_PRICES_INCLUDE_VAT=true
VAT_COLLECT_BIRTH_YEAR=false
VAT_EXEMPT_UNDER_AGE=0
