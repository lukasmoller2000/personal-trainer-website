# === Påkrævet for at booking og kontakt virker ===
# Opret gratis på https://resend.com/api-keys (Free: 100 e-mails/dag, 3.000/md.)
# Uden denne nøgle returnerer formularerne 503 — der vises aldrig falsk success.
# Vercel → Project → Settings → Environment Variables → Production (+ Preview)
RESEND_API_KEY=

# === Påkrævet for sitemap, robots og Open Graph i produktion ===
# Canonical offentlig URL. Der findes IKKE en separat SITE_URL.
# Local:  http://localhost:3000
# Live:   https://dit-domæne.dk   (uden trailing slash)
# Vercel → samme sted som ovenfor. Sæt den til det rigtige .dk-domæne, ikke localhost.
NEXT_PUBLIC_SITE_URL=

# === Valgfri. PostgreSQL (Neon eller Vercel Postgres, free tier) ===
# Uden DATABASE_URL virker siden stadig: booking/kontakt sender kun e-mail.
# Med DATABASE_URL gemmes bookinger og kontaktbeskeder også.
# Neon: https://console.neon.tech (gratis) — brug den UPOOLEDE / direct connection string
# med sslmode=require. Vercel kører `prisma migrate deploy` i build, når variablen er sat.
DATABASE_URL=

# === Valgfri Resend-afsender/modtager ===
# TO: defaults til lukasmoller2000@gmail.com (samme som på siden)
BOOKINGS_NOTIFY_EMAIL=

# FROM: indtil et domæne er verificeret på https://resend.com/domains, behold Resends test-afsender.
# Med beth.t@example.com kan du KUN sende TIL den e-mail, du oprettede Resend-kontoen med.
# Efter verificering af dit .dk-domæne: Lukas Møller <booking@dit-domæne.dk>
RESEND_FROM_EMAIL=
