# Required for booking and contact forms. Create at https://resend.com/api-keys
# Without this, forms return 503 and never show a fake success.
RESEND_API_KEY=

# Optional. Defaults to lukasmoller2000@gmail.com
BOOKINGS_NOTIFY_EMAIL=

# Optional. Until a domain is verified at https://resend.com/domains, keep Resend's test sender.
# With beth.t@example.com you can only send TO the email you signed up with.
# After verifying your .dk domain, use e.g. Lukas Møller <booking@dit-domæne.dk>
RESEND_FROM_EMAIL=

# Canonical public URL for sitemap, robots and Open Graph.
# This is the ONLY site URL variable. There is no separate SITE_URL.
# Local:  http://localhost:3000
# Live:   https://dit-domæne.dk   (no trailing slash)
# Set this on Vercel Production. Do not leave it empty or set to localhost in production.
NEXT_PUBLIC_SITE_URL=

# Optional. PostgreSQL (Neon or Vercel Postgres, free tier).
# Without DATABASE_URL the site still works: booking/contact send email only.
# With DATABASE_URL they are also stored (bookings + contact messages).
#
# After creating a free Neon/Vercel Postgres database:
#   1. Paste the connection string below (sslmode=require)
#   2. npx prisma migrate deploy
#   3. npx prisma generate
# Prisma schema: prisma/schema.prisma
# SQL: prisma/migrations/20260824120000_init/migration.sql
DATABASE_URL=
