# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel (never commit prebuilt output or project link)
.vercel
.vercel/output
Dockerfile
Dockerfile.vercel
Containerfile
Containerfile.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bookings
/data/bookings.json

# local-only Postgres / verify scratch (never commit)
/tmp-local-pg/
/tmp-verify-live/
scripts/_verify-pack5-tmp.mjs
